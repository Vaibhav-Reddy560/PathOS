<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>com.vaibhavreddy.pathos.refresh</string>
	</array>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>PathOS</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>1.0</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.vaibhavreddy.pathos</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>pathos</string>
			</array>
		</dict>
	</array>
	<key>CFBundleVersion</key>
	<string>1</string>
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>uber</string>
		<string>olacabs</string>
		<string>rapido</string>
	</array>
	<key>NSCalendarsFullAccessUsageDescription</key>
	<string>PathOS shows events from your calendars, including ones you subscribe to, on the map with their places.</string>
	<key>NSCalendarsWriteOnlyAccessUsageDescription</key>
	<string>PathOS adds events scanned from posters to your calendar.</string>
	<key>NSCameraUsageDescription</key>
	<string>PathOS uses the camera to scan posters, receipts, and parking indicators into spatial actions.</string>
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>PathOS tracks geofences to surface context-aware departure warnings and parking memory.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>PathOS uses your location to provide directional spatial guidance and geofenced memory alerts.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>PathOS analyzes ambient noise levels to adjust alert haptics and listens to your voice questions.</string>
	<key>NSMotionUsageDescription</key>
	<string>PathOS reads barometric pressure changes to predict local rain shifts upon departure.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>PathOS can scan posters and receipts from your photos.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>PathOS transcribes your voice questions on-device.</string>
	<key>NSSupportsLiveActivities</key>
	<true/>
	<key>NSSupportsLiveActivitiesFrequentUpdates</key>
	<true/>
	<key>UIBackgroundModes</key>
	<array>
		<string>location</string>
		<string>fetch</string>
		<string>processing</string>
	</array>
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>LaunchBackground</string>
	</dict>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UIUserInterfaceStyle</key>
	<string>Dark</string>
</dict>
</plist>
